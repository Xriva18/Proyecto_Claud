# Postgres (local docker-compose)
# kguanoluisa, Plantilla de variables; en Render cada servicio usa su propio formato de URL de BD, sin nuevas variables, 2026-07-17
DATABASE_URL=postgresql://analyticore:analyticore@postgres:5432/db_analyticore

# Java Spring Boot (usar prefijo jdbc: en Render)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/db_analyticore
DB_USER=analyticore
DB_PASSWORD=analyticore

# Python → Java (red Docker)
JAVA_SERVICE_URL=http://java-service:8080

# Frontend build (URL pública del API Python)
# Local sin Docker: http://localhost:8000
# Docker con Nginx proxy: /api
VITE_API_URL=http://localhost:8000
